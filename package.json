{
  "name": "playwright-102-testmuai",
  "version": "1.0.0",
  "description": "Playwright test automation for TestMu AI Selenium Playground",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:scenario1": "playwright test tests/simple-form-demo.spec.ts",
    "test:scenario2": "playwright test tests/drag-drop-slider.spec.ts",
    "test:scenario3": "playwright test tests/input-form-submit.spec.ts",
    "test:parallel": "playwright test --workers=4",
    "test:headed": "playwright test --headed",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:ci": "CI=true playwright test --reporter=html,json,junit",
    "clean": "rm -rf playwright-report test-results artifacts dist",
    "lint": "echo 'Lint setup required'",
    "setup": "npm install && npx playwright install"
  },
  "keywords": [],
  "author": "Test Automation Team",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.0.0",
    "dotenv": "^16.3.1",
    "typescript": "^5.3.3"
  }
}
