# ============================================================================
# Environment Variables for Playwright 102 TestMUAI
# Copy this file to .env and fill in actual values
# These will be injected into HyperExecute and local test runs
# DO NOT commit actual credentials to version control
# ============================================================================

# ============================================================================
# Application Configuration
# ============================================================================
BASE_URL=https://www.testmuai.com/selenium-playground/
HEADLESS=true
CI=false
NODE_ENV=test

# ============================================================================
# HyperExecute Configuration
# ============================================================================
EXECUTION_ENV=local
PLATFORM=Windows 10
BROWSER_VERSION=latest
BUILD_NAME=Playwright-102-Local-Build
BUILD_NUMBER=1

# ============================================================================
# Test Execution Configuration
# ============================================================================
LOG_LEVEL=info
ENABLE_VIDEO=true
ENABLE_SCREENSHOTS=true
ENABLE_CONSOLE_LOGS=true
ENABLE_NETWORK_LOGS=true

# ============================================================================
# SECRETS - Store these securely in HyperExecute dashboard
# These should be set as GitHub Secrets or HyperExecute Secrets
# DO NOT commit actual values to version control
# ============================================================================
# TESTMUAI_USERNAME=your_username_here
# TESTMUAI_PASSWORD=your_password_here
# API_TOKEN=your_api_token_here
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================================================
# HyperExecute Credentials (if using direct HyperExecute API)
# ============================================================================
# HE_ACCESS_KEY=your_hyperexecute_access_key
# HE_USER_ID=your_hyperexecute_user_id
